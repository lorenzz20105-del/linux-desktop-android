#!/bin/sh
# Starts a graphical program on the desktop display (:1). Usage: app-run <command> [args...]
export HOME=/root USER=root LANG=C.UTF-8 DISPLAY=:1 XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p /tmp/runtime-root && chmod 700 /tmp/runtime-root
if [ ! -S /tmp/.X11-unix/X1 ]; then
  echo "app-run: the desktop is not running" >&2
  exit 1
fi
exec "$@"
