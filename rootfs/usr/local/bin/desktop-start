#!/bin/sh
# Runs inside the proot rootfs. Starts Xvfb, x11vnc (localhost only, password protected) and XFCE.
# Needs VNC_PASSWORD in the environment. Optional: DESK_RES (default 1280x720).
export HOME=/root USER=root LOGNAME=root LANG=C.UTF-8 DISPLAY=:1
export XDG_RUNTIME_DIR=/tmp/runtime-root XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE
RES=${DESK_RES:-1280x720}

if [ -z "${VNC_PASSWORD:-}" ]; then
  echo "desktop-start: VNC_PASSWORD is not set" >&2
  exit 2
fi

mkdir -p /tmp/.X11-unix /tmp/runtime-root /root/.vnc
chmod 1777 /tmp /tmp/.X11-unix
chmod 700 /tmp/runtime-root
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1

x11vnc -storepasswd "$VNC_PASSWORD" /root/.vnc/passwd >/dev/null 2>&1
chmod 600 /root/.vnc/passwd

# Screen depth 24. The Android app draws its own cursor, so x11vnc does not paint one.
Xvfb :1 -screen 0 "${RES}x24" -nolisten tcp -ac -noreset >/tmp/xvfb.log 2>&1 &
i=0
while [ ! -S /tmp/.X11-unix/X1 ] && [ $i -lt 100 ]; do sleep 0.2; i=$((i+1)); done
if [ ! -S /tmp/.X11-unix/X1 ]; then
  echo "desktop-start: Xvfb did not start, see /tmp/xvfb.log" >&2
  cat /tmp/xvfb.log >&2
  exit 3
fi

x11vnc -display :1 -rfbauth /root/.vnc/passwd -rfbport 5901 -localhost -forever -shared \
  -noxdamage -nocursor -quiet >/tmp/x11vnc.log 2>&1 &

# Desktop shortcuts for the preinstalled apps. Existing files are kept, so edits survive restarts.
mkdir -p /root/Desktop /root/.config/autostart
mk_launcher() {
  f="/root/Desktop/$1.desktop"
  [ -f "$f" ] || printf '[Desktop Entry]\nType=Application\nName=%s\nExec=%s\nIcon=%s\nTerminal=false\n' "$1" "$2" "$3" > "$f"
  chmod 755 "$f"
}
mk_launcher "Terminal" "/usr/local/bin/app-run xfce4-terminal" "utilities-terminal"
mk_launcher "Firefox" "/usr/local/bin/app-run firefox-esr" "firefox-esr"
mk_launcher "Text Editor" "/usr/local/bin/app-run mousepad" "accessories-text-editor"
mk_launcher "Files" "/usr/local/bin/app-run thunar" "system-file-manager"
if [ -e /usr/lib/wine/wine64 ]; then
  mk_launcher "Windows Notepad" "/usr/local/bin/wine-run notepad" "accessories-text-editor"
  mk_launcher "Windows Explorer" "/usr/local/bin/wine-run explorer" "folder"
fi

# Preinstalled coding tools (agents add-on). A shortcut appears only when its tool is installed.
if command -v claude >/dev/null 2>&1; then
  mk_launcher "Claude Code" "/usr/local/bin/app-run xfce4-terminal -e claude" "utilities-terminal"
fi
if command -v codex >/dev/null 2>&1; then
  mk_launcher "Codex" "/usr/local/bin/app-run xfce4-terminal -e codex" "utilities-terminal"
fi
if command -v freebuff >/dev/null 2>&1; then
  mk_launcher "Freebuff CLI" "/usr/local/bin/app-run xfce4-terminal -e freebuff" "utilities-terminal"
fi
if [ -x /opt/freebuff/AppRun ]; then
  mk_launcher "Freebuff Desktop" "/usr/local/bin/freebuff-desktop" "applications-internet"
fi
if [ -x /opt/vscode-server/bin/code-server ]; then
  mk_launcher "VS Code" "/usr/local/bin/vscode-start" "com.visualstudio.code"
fi

# Login screen at every desktop start (like a PC sign-in page).
cat > /root/.config/autostart/desktop-login.desktop <<'EOD'
[Desktop Entry]
Type=Application
Name=Login screen
Exec=/usr/local/bin/desktop-login
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOD
rm -rf /tmp/desktop-login.lock

exec dbus-launch --exit-with-session startxfce4
